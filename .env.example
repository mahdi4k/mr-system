NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Telegram notification configuration for new ads (outbound).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Server-only Telegram inbound webhook (forward to Rigora).
# Set the same secret in BotFather setWebhook secret_token and here.
TG_WEBHOOK_SECRET=
# Your numeric Telegram user ID (e.g. from @userinfobot). Only this user can create ads via bot.
# If omitted, falls back to TELEGRAM_ADMIN_CHAT_ID — set MY_TELEGRAM_ID only if they differ.
MY_TELEGRAM_ID=
# Supabase profiles.id that will own ads created via Telegram webhook (your user UUID).
TELEGRAM_OWNER_USER_ID=

# Server-only Supabase secret key (sb_secret_...) — the modern replacement for
# the legacy service_role key. Used by the price-sync worker and the one-time
# product-image import. Never expose it to the browser; never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only outbound email. Sends the "your ad is published" notice to the ad
# owner when a moderator publishes an ad. Without any of these, publishing still
# works and only the email is skipped.
#
# Preferred: SMTP. A `.ir` sending domain can never get a publicly trusted TLS
# certificate, so no hosted provider (Resend, SendGrid, Postmark, ...) will
# accept it as a custom sending domain. A Gmail account with an App Password
# works around that with no domain at all:
#   Google Account -> Security -> 2-Step Verification -> App passwords
#   generate one, then paste it as SMTP_PASSWORD (spaces removed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=
# Optional. Defaults to SMTP_USER when empty.
SMTP_FROM=Rigora <your.address@gmail.com>
# Optional. Defaults to true. Nodemailer picks a random address between the A and
# AAAA records, so a host that resolves on IPv6 but has no IPv6 route fails
# intermittently. Pinning IPv4 avoids that; set to false only on an IPv6-only host.
SMTP_FORCE_IPV4=true

# Optional alternative: Resend, once you own a domain whose TLD can be certified
# (for example a .com used only for sending). Takes priority over nothing, SMTP
# wins if both are set.
RESEND_API_KEY=
RESEND_FROM=Rigora <no-reply@your-domain.com>

# Server-only Parse.bot (Torob acquisition) configuration.
# The real key belongs only in .env.local and must never be exposed to the browser.
PARSE_BOT_API_KEY=

# Price synchronization worker tuning (optional, sensible defaults are built in).
PRICE_SYNC_BATCH_SIZE=20
PRICE_SYNC_CONCURRENCY=2
# Optional: reveal the retained phone OTP login after configuring an SMS provider.
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false

# Optional: retained only for the existing WordPress comment feature.
NEXT_PUBLIC_WORDPRESS_API=
