NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Telegram notification configuration for new ads (outbound).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Server-only Telegram inbound webhook (forward to Rigora).
# Set the same secret in BotFather setWebhook secret_token and here.
TG_WEBHOOK_SECRET=
# Your numeric Telegram user ID (e.g. from @userinfobot). Only this user can create ads via bot.
# If omitted, falls back to TELEGRAM_ADMIN_CHAT_ID — set MY_TELEGRAM_ID only if they differ.
MY_TELEGRAM_ID=
# Supabase profiles.id that will own ads created via Telegram webhook (your user UUID).
TELEGRAM_OWNER_USER_ID=

# Server-only Supabase secret key (sb_secret_...) — the modern replacement for
# the legacy service_role key. Used by the price-sync worker and the one-time
# product-image import. Never expose it to the browser; never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only Parse.bot (Torob acquisition) configuration.
# The real key belongs only in .env.local and must never be exposed to the browser.
PARSE_BOT_API_KEY=

# Price synchronization worker tuning (optional, sensible defaults are built in).
PRICE_SYNC_BATCH_SIZE=20
PRICE_SYNC_CONCURRENCY=2
# Optional: reveal the retained phone OTP login after configuring an SMS provider.
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false

# Optional: retained only for the existing WordPress comment feature.
NEXT_PUBLIC_WORDPRESS_API=
